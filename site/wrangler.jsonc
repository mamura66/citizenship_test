{
  // Worker + static assets. Cloudflare serves ./public directly for everything except the
  // paths in `run_worker_first`; those reach src/worker.js. That keeps the marketing site
  // and the question packs on the CDN while the API and the sign-in wall run as code.
  "name": "uscitizenship-pulse-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  // Also expose a *.workers.dev URL. The custom domain inherits pastclimate.com's
  // zone security, which is currently issuing a bot challenge to every client
  // (cf-mitigated: challenge) - unusable for a URL Apple has to fetch. workers.dev
  // sits outside the zone, so it is a working fallback.
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    // The Worker needs to be able to fetch an asset itself, to serve the app page once it
    // has checked the session.
    "binding": "ASSETS",
    // Serve the nearest 404.html rather than pretending every path is the app.
    "not_found_handling": "404-page",
    // Without this the asset router would answer /api/* and /app from ./public before the
    // Worker ever ran - /api/* would 404 and the app page would load signed out.
    // The sign-in pages are worker-first too, only so the www -> apex canonicalisation
    // can run on them. Without it, someone landing on www stays on www, the session
    // cookie is set for the apex, and their POST to /api/auth/login meets a 301 - which
    // browsers retry as a GET, so signing in from www would simply fail.
    "run_worker_first": [
      "/api/*", "/app", "/app.html",
      "/login", "/login.html", "/signup", "/signup.html",
      "/forgot", "/forgot.html", "/reset", "/reset.html",
      // Search-engine verification files. They do not exist on disk - the Worker builds
      // them from configuration - so without this the asset router answers with the 404
      // page and the Worker never runs. That is not a hypothetical: it happened.
      "/google*", "/BingSiteAuth.xml",
      // The owner-only analytics page. There is no /insights file in ./public - the Worker
      // builds the page - so without this line the asset router answers it with the 404
      // page and the gate never runs. Same trap as the verification files above.
      "/insights"
    ]
  },
  // Cloudflare Email Service. Used for one thing: the password reset link. No API key and
  // no DNS records, because the domain is already on this account - the runtime
  // authenticates the send itself.
  "send_email": [{ "name": "EMAIL" }],
  // Users, sessions, entitlements and progress. See src/lib/store.js for the key layout.
  "kv_namespaces": [
    { "binding": "PFC", "id": "7dc1d7e034fe45c99f257b0766dfc0db" }
  ],
  // First-party analytics counters. D1 rather than KV because this is counting and
  // grouping, which KV cannot do - it would mean listing every key to answer "top
  // countries". Nothing personal is in here: no visitor id, no IP, no account id. See
  // migrations/0001_analytics.sql and src/lib/analytics.js.
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "pfc-analytics",
      "database_id": "b13e5695-89e7-4d5a-8285-a38c0ff66688",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Non-secret configuration only. The secrets - GOOGLE_CLIENT_ID/SECRET,
    // PADDLE_API_KEY and PADDLE_WEBHOOK_SECRET - are set with `wrangler secret put` and
    // never live in this file.
    //
    // LIVE. Real cards are charged. Set this back to "sandbox" with the sandbox token and
    // price id to stop taking money - the orange test banner is driven by this value, so
    // it cannot be left on or off by accident.
    // The canonical origin. Password reset links and the Google redirect URI are built
    // from this and never from the request's Host header - see src/lib/origin.js.
    "PUBLIC_ORIGIN": "https://prepareforcitizenship.com",
    // Search engine site verification. Set to the token each console gives you and the
    // Worker serves the file it looks for - no HTML editing, and nothing to forget to
    // remove later.
    "GOOGLE_SITE_VERIFICATION": "",
    "BING_SITE_VERIFICATION": "",
    // Google Analytics 4, at Sandeep's instruction. GA4 sets cookies, so two things had to
    // ship with it: the privacy policy no longer claims we run no analytics, and visitors
    // in the EEA, the UK and Switzerland are asked before anything is stored. Google
    // Consent Mode is set to denied by default everywhere. See docs/SEO-AND-ANALYTICS.md.
    "ANALYTICS": "ga4",
    "GA4_MEASUREMENT_ID": "G-H00CSNW239",
    "CF_ANALYTICS_TOKEN": "",
    // Who may see /insights and /api/analytics. Everybody else gets a 404, signed in or
    // not. Here rather than in source because an email address hardcoded in a route is a
    // personal address published in the repo, and because a second person should be
    // addable without a code change - a comma-separated list is accepted. Empty means
    // nobody, which is the right way for a misconfigured deploy to fail.
    "ANALYTICS_OWNER_EMAIL": "sandeep.sandha@gmail.com",
    "PADDLE_ENVIRONMENT": "production",
    // "true" while Paddle has not finished approving the account, so the paywall says so
    // plainly instead of opening a checkout Paddle will refuse. Set to "false" the day
    // website approval lands - that is the only change needed to start selling.
    "PADDLE_SALES_PAUSED": "true",
    // The address password-reset mail is sent from. Must be on a domain on this
    // Cloudflare account, or Email Service refuses the send as an unverified sender.
    //
    // hello@ rather than noreply@ on purpose: someone who gets an unexpected password
    // reset email will reply to it asking what is going on, and that reply has to reach a
    // person. Cloudflare Email Routing forwards hello@ to a real inbox, so it does.
    "MAIL_FROM": "Prepare for Citizenship <hello@prepareforcitizenship.com>",
    // Designed to be public - Paddle.js needs it in the page. Safe in the repo.
    "PADDLE_CLIENT_TOKEN": "live_43ed8dda0eebbd89b61c9f67fe2",
    // The one-time $9.99 "Full access" price on pro_01m1y1mgwpz2ym81wvs1ep5b3f,
    // tax_mode external and max quantity 1.
    "PADDLE_PRICE_ID": "pri_01m1y1nq68tgc2arc41myd697b"
  },
  // Custom domain. Cloudflare creates the DNS record and certificate for this
  // subdomain on deploy; nothing else on pastclimate.com is touched.
  "routes": [
    { "pattern": "prepareforcitizenship.com", "custom_domain": true },
    { "pattern": "www.prepareforcitizenship.com", "custom_domain": true },
    // Kept so the URLs Apple already has on file keep resolving. pastclimate.com is
    // behind Under Attack Mode, so that hostname still returns a bot challenge.
    { "pattern": "pulse.pastclimate.com", "custom_domain": true }
  ]
}
